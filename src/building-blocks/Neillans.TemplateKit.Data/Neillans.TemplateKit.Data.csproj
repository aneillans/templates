<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Neillans.TemplateKit.Data</PackageId>
    <Version>1.1.0</Version>
    <Description>Database provider abstraction with PostgreSQL default and MySQL support.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <!-- Pin transitive dependency of MySql.Data to patched version (Snyk) -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
