{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=demoapi;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Jwt": {
      "Authority": "http://localhost:8080/realms/template-realm",
      "Audience": "api-host",
      "RequireHttpsMetadata": false
    }
  }
}
