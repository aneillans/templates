<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Neillans.Templates.Mvc</PackageId>
    <Version>1.1.0</Version>
    <Authors>Neillans</Authors>
    <Description>Neillans MVC project template with OIDC auth, docker, and Materio hooks.</Description>
    <PackageTags>dotnet-new;template;mvc;oidc;keycloak;materio</PackageTags>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\node_modules\**;content\**\.angular\**;content\**\dist\**" PackagePath="content" />
  </ItemGroup>
</Project>
