{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "http://localhost:8081/realms/template-realm",
      "ClientId": "mvc-host",
      "ClientSecret": "mvc-host-secret"
    }
  }
}
