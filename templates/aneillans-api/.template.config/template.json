{
  "$schema": "http://json.schemastore.org/template",
  "author": "Aneillans",
  "classifications": ["Web", "API", "OIDC", "Docker"],
  "identity": "Aneillans.Templates.Api",
  "name": "Aneillans API Template",
  "shortName": "aneillans-api",
  "sourceName": "ApiHost",
  "preferNameDirectory": true,
  "symbols": {
    "useSwagger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Enable Swagger/OpenAPI"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!useSwagger)",
          "exclude": [
            "src/ApiHost/Endpoints/SwaggerOnlyEndpoint.cs"
          ]
        }
      ]
    }
  ]
}
